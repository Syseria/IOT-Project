                      "group": "influxdb",
                      "kind": "DataQuery",
                      "spec": {
                        "query": "from(bucket: \"ttn_parking_data\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"parking_spot\")\n  |> filter(fn: (r) => r[\"_field\"] == \"occupied\")\n  |> last()\n  |> toInt() // Ensures booleans (true/false) become numbers (1/0)\n  |> group() // Combines all 150 sensors into a single table\n  |> sum()\n  |> map(fn: (r) => ({ r with _value: (float(v: r._value) / 150.0) * 100.0 }))"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
