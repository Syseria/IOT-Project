                      "group": "influxdb",
                      "kind": "DataQuery",
                      "spec": {
                        "query": "// --- SIMULATION SCALING CONFIGURATION ---\nsimulated_cpu_minutes = 0.0004 \ntarget_python_mean = 62.5 \n\ntime_warp_factor = target_python_mean / simulated_cpu_minutes\n\nfrom(bucket: \"ttn_parking_data\")\n  |> range(start: -1h) \n  |> filter(fn: (r) => r[\"_measurement\"] == \"parking_spot\")\n  |> filter(fn: (r) => r[\"_field\"] == \"occupied\")\n  |> elapsed(unit: 1m)\n  |> filter(fn: (r) => r[\"_value\"] == 0)\n  |> group()\n  |> mean(column: \"elapsed\")\n  |> map(fn: (r) => ({ _value: r.elapsed * time_warp_factor }))"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
